{
  "title": "QlikGPT - Sales Performance",
  "targetApp": "presentation",
  "developmentStatus": "deployed-native-qix",
  "sheets": [
    {
      "id": "qlikgpt-sales-overview",
      "title": "Sales Overview",
      "layout": "responsive-grid",
      "filters": [
        "SalesYear",
        "Market",
        "Channel"
      ],
      "kpis": [
        {
          "id": "kpi-revenue",
          "title": "Total Revenue",
          "expression": "Sum(Revenue)"
        },
        {
          "id": "kpi-orders",
          "title": "Orders",
          "expression": "Count(DISTINCT OrderID)"
        },
        {
          "id": "kpi-margin",
          "title": "Margin %",
          "expression": "Num(Sum(Margin)/Sum(Revenue), '0.0%')"
        },
        {
          "id": "kpi-margin-eur",
          "title": "Margine",
          "expression": "Sum(Margin)"
        }
      ],
      "visualizations": [
        {
          "id": "chart-monthly-sales",
          "type": "linechart",
          "dimension": "YearMonth",
          "measure": "Sum(Revenue)"
        },
        {
          "id": "chart-sales-market",
          "type": "barchart",
          "dimension": "Market",
          "measure": "Sum(Revenue)"
        }
      ]
    }
  ],
  "note": "Native text-image brand header plus compact associative filter pane, 4 KPI and 2 charts. ETL1 uses 12 full historical months to avoid misleading partial-month drops.",
