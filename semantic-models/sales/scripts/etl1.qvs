// ================================================================
// QlikGPT - ETL1 / RAW
// Extract layer: generates 5,000 orders over twelve full months (Oct 2025 to Sep 2026).
// The three apps must live in the SAME Qlik Cloud space.
// ================================================================

SET ErrorMode=1;
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyDecimalSep='.';
SET DateFormat='YYYY-MM-DD';

RawOrders:
LOAD
    'ORD-' & Num(RecNo(), '000000')                       AS OrderID,
    Date(MakeDate(2025, 10, 1) + Floor(Rand() * 365))     AS OrderDate,
    Pick(1 + Floor(Rand() * 4),
        'Italy', 'France', 'Germany', 'Spain')              AS Market,
    Pick(1 + Floor(Rand() * 4),
        'Hardware', 'Software', 'Services', 'Accessories') AS ProductCategory,
    Pick(1 + Floor(Rand() * 3),
        'Online', 'Retail', 'Partner')                      AS Channel,
    'CUST-' & Num(1 + Floor(Rand() * 120), '000')          AS CustomerID,
    1 + Floor(Rand() * 8)                                 AS Quantity,
    Round(40 + Rand() * 500, 0.01)                        AS UnitPrice,
    Round(0.45 + Rand() * 0.30, 0.0001)                   AS CostRatio
AUTOGENERATE 5000;

// Qlik Cloud creates the target folder during STORE if necessary.
// An unqualified DataFiles connection points to the app's space.
STORE RawOrders
INTO [lib://DataFiles/QlikGPT/01_RAW/RawOrders.qvd] (qvd);

TRACE QlikGPT ETL1 completed: RAW QVD generated.;
