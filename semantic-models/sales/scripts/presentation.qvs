// ================================================================
// QlikGPT - PRESENTATION / ASSOCIATIVE DATA MODEL
// Loads only transformed QVDs and prepares the analytics model.
// Dashboard objects (sheets/charts/KPIs) are a separate next step.
// ================================================================

SET ErrorMode=1;
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyFormat='#,##0.00';
SET DateFormat='YYYY-MM-DD';

FactSales:
LOAD
    OrderID,
    Date(Floor(OrderDate))                                AS OrderDate,
    Market,
    ProductCategory,
    Channel,
    CustomerID,
    Quantity,
    UnitPrice,
    Revenue,
    Cost,
    Round(Revenue - Cost, 0.01)                           AS Margin,
    If(Revenue > 0, (Revenue - Cost) / Revenue, 0)         AS MarginPct
FROM [lib://DataFiles/QlikGPT/02_TRANSFORM/Sales_Clean.qvd] (qvd);

// The sole shared key between FactSales and Calendar is OrderDate.
// This avoids a synthetic key for the final associative model.
Calendar:
LOAD DISTINCT
    OrderDate,
    Year(OrderDate)         AS SalesYear,
    Month(OrderDate)        AS SalesMonth,
    MonthName(OrderDate)    AS YearMonth,
    QuarterName(OrderDate)  AS YearQuarter
RESIDENT FactSales;

TRACE QlikGPT PRESENTATION completed: FactSales and Calendar loaded.;
