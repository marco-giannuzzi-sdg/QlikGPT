{
  "schemaVersion": 1,
  "governance": {
    "owner": "BI Architecture",
    "deletePolicy": "explicit-approval-only",
    "contract": "Every app master measure is catalog-governed; unassigned definitions stay available."
  },
  "measures": [
    {
      "id": "qlikgpt_shared_revenue",
      "title": "Fatturato",
      "expression": "Sum(Revenue)",
      "description": "Fatturato totale con filtri associativi; definizione canonica del catalogo.",
      "requiredFields": [
        "Revenue"
      ],
      "tags": [
        "Semantic Catalog",
        "Sales",
        "Governed"
      ],
      "version": "1.0.2",
      "formatPreset": "currency_eur_2",
      "compactFormatPreset": "currency_millions",
      "colorRole": "revenue"
    },
    {
      "id": "qlikgpt_shared_orders",
      "title": "Numero ordini",
      "expression": "Count(DISTINCT OrderID)",
      "description": "Numero ordini distinti.",
      "requiredFields": [
        "OrderID"
      ],
      "tags": [
        "Semantic Catalog",
        "Sales",
        "Governed"
      ],
      "version": "1.0.0",
      "formatPreset": "integer_0",
      "colorRole": "orders"
    },
    {
      "id": "qlikgpt_shared_margin",
      "title": "Margine lordo",
      "expression": "Sum(Margin)",
      "description": "Somma dei margini commerciali.",
      "requiredFields": [
        "Margin"
      ],
      "tags": [
        "Semantic Catalog",
        "Sales",
        "Governed"
      ],
      "version": "1.0.0",
      "formatPreset": "currency_eur_2",
      "compactFormatPreset": "currency_millions",
      "colorRole": "margin"
    },
    {
      "id": "qlikgpt_shared_margin_pct",
      "title": "Margine %",
      "expression": "If(Sum(Revenue)>0,Sum(Margin)/Sum(Revenue),0)",
      "description": "Marginalità commerciale percentuale.",
      "requiredFields": [
        "Revenue",
        "Margin"
      ],
      "tags": [
        "Semantic Catalog",
        "Sales",
        "Governed"
      ],
      "version": "1.0.1",
      "formatPreset": "percent_1",
      "colorRole": "positive"
    },
    {
      "id": "qlikgpt_shared_average_order",
      "title": "Valore medio ordine",
      "expression": "If(Count(DISTINCT OrderID)>0,Sum(Revenue)/Count(DISTINCT OrderID),0)",
      "description": "Disponibile per future sottoscrizioni; nessuna app la utilizza oggi.",
      "requiredFields": [
        "Revenue",
        "OrderID"
      ],
      "tags": [
        "Semantic Catalog",
        "Sales",
        "Available"
      ],
      "version": "1.0.0",
      "formatPreset": "currency_eur_2",
      "colorRole": "revenue"
    }
  ]
}
