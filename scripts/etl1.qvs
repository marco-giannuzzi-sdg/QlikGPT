// ===============================================================
// ETL1 - RAW layer
// PoC QlikGPT: 5,000 synthetic orders, no external data sources.
// ===============================================================

SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET DateFormat='DD/MM/YYYY';

RawSales:
LOAD
    'ORD-' & Num(RecNo(), '000000')                       AS OrderID,
    Date(MakeDate(2025, 1, 1) + Floor(Rand() * 650))      AS OrderDate,
    Pick(1 + Floor(Rand() * 4),
        'Italy', 'France', 'Germany', 'Spain')              AS Market,
    Pick(1 + Floor(Rand() * 4),
        'Hardware', 'Software', 'Services', 'Accessories') AS ProductCategory,
    Pick(1 + Floor(Rand() * 3),
        'Online', 'Retail', 'Partner')                      AS Channel,
    'CUST-' & Num(1 + Floor(Rand() * 120), '000')          AS CustomerID,
    1 + Floor(Rand() * 8)                                 AS Quantity,
    Round(40 + Rand() * 500, 0.01)                        AS UnitPrice,
    Round(0.45 + Rand() * 0.30, 0.0001)                   AS CostRatio
AUTOGENERATE 5000;
