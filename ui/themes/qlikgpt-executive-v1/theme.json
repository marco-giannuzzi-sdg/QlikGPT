{
  "_inherit": true,
  "_cards": true,
  "_variables": {
    "@qlikgpt-navy": "#142840",
    "@qlikgpt-teal": "#16A39A",
    "@qlikgpt-blue": "#3365D5",
    "@qlikgpt-ink": "#1F2A37",
    "@qlikgpt-muted": "#6B7280",
    "@qlikgpt-surface": "#FFFFFF",
    "@qlikgpt-canvas": "#F5F7FB",
    "@qlikgpt-border": "#E3E9F1"
  },
  "color": "@qlikgpt-ink",
  "fontFamily": "Arial, Helvetica, sans-serif",
  "fontSize": "13px",
  "backgroundColor": "@qlikgpt-surface",
  "dataColors": {
    "primaryColor": "#3365D5",
    "othersColor": "#6B7280",
    "errorColor": "#DC2626",
    "nullColor": "#CBD5E1",
    "selected": "#16A39A",
    "alternative": "#DCE7F7",
    "excluded": "#A6B1C1",
    "selectedExcluded": "#66758C",
    "possible": "#FFFFFF"
  },
  "object": {
    "title": {
      "main": {
        "color": "#142840",
        "fontFamily": "Arial, Helvetica, sans-serif",
        "fontSize": "15px"
      },
      "subTitle": {
        "color": "#6B7280",
        "fontFamily": "Arial, Helvetica, sans-serif",
        "fontSize": "12px"
      }
    },
    "axis": {
      "label": {
        "name": {
          "color": "#6B7280",
          "fontSize": "11px"
        }
      }
    },
    "grid": {
      "line": {
        "major": {
          "color": "#E3E9F1"
        },
        "minor": {
          "color": "#F5F7FB"
        }
      }
    },
    "kpi": {
      "backgroundColor": "#FFFFFF",
      "label": {
        "name": {
          "color": "#6B7280",
          "fontFamily": "Arial, Helvetica, sans-serif",
          "fontSize": "13px"
        },
        "value": {
          "color": "#142840",
          "fontFamily": "Arial, Helvetica, sans-serif",
          "fontSize": "32px"
        }
      }
    },
    "barChart": {
      "backgroundColor": "#FFFFFF",
      "title": {
        "main": {
          "color": "#142840",
          "fontSize": "15px"
        }
      }
    },
    "lineChart": {
      "backgroundColor": "#FFFFFF",
      "title": {
        "main": {
          "color": "#142840",
          "fontSize": "15px"
        }
      }
    },
    "filterpane": {
      "backgroundColor": "#FFFFFF"
    },
    "textImage": {
      "backgroundColor": "#FFFFFF"
    }
  },
  "sheet": {
    "title": {
      "private": {
        "titleBackgroundColor": "#142840",
        "titleBackgroundGradientColor": "#3365D5"
      },
      "approved": {
        "titleBackgroundColor": "#142840",
        "titleBackgroundGradientColor": "#3365D5"
      },
      "published": {
        "titleBackgroundColor": "#142840",
        "titleBackgroundGradientColor": "#3365D5"
      }
    }
  }
}
