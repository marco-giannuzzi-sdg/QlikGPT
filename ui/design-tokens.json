{
  "schemaVersion": 1,
  "templateId": "qlikgpt-executive-v1",
  "name": "QlikGPT Executive Premium",
  "version": "1.1.0",
  "purpose": "Model-agnostic, Qlik-native premium presentation system",
  "colors": {
    "canvas": "#F5F7FB",
    "surface": "#FFFFFF",
    "card": "#FFFFFF",
    "navy": "#142840",
    "teal": "#16A39A",
    "blue": "#3365D5",
    "success": "#16A34A",
    "text": "#1F2A37",
    "muted": "#6B7280",
    "border": "#E3E9F1",
    "inverse": "#FFFFFF",
    "paleBlue": "#EDF3FF",
    "softTeal": "#EAF8F6",
    "softBlue": "#F0F5FF"
  },
  "fontFamily": "Arial, Helvetica, sans-serif",
  "grid": {
    "columns": 24,
    "minimumRows": 9,
    "headerRows": 1,
    "navigationRows": 1,
    "kpiRows": 3
  },
  "styles": {
    "header": {
      "background": "paleBlue",
      "text": "navy"
    },
    "navigation": {
      "background": "navy",
      "text": "inverse",
      "accent": "blue"
    },
    "kpi": {
      "background": "card",
      "title": "navy"
    },
    "chart": {
      "background": "surface",
      "title": "navy"
    },
    "filter": {
      "background": "surface",
      "text": "text"
    }
  },
  "rules": {
    "maxKpisPerRow": 4,
    "minimumKpiColumns": 6,
    "masterMeasuresOnly": true,
    "masterDimensionsOnly": true,
    "neverDeployReloadOnStyleChange": true,
    "visualLanguage": "executive-premium",
    "designContract": "no-inline-metrics",
    "noMockDeltas": true
  }
}
