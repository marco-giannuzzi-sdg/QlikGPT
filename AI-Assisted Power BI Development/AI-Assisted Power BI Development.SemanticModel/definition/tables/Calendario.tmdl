	partition Calendario = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFolder & "Calendario.xlsx"), null, true),
				    Navigation = Source{[Item="Calendario", Kind="Table"]}[Data],
				    Typed = Table.TransformColumnTypes(Navigation, {{"Data", type date}, {"Anno", Int64.Type}, {"MeseNumero", Int64.Type}, {"Mese", type text}, {"AnnoMese", type text}, {"AnnoMeseNumero", Int64.Type}, {"Trimestre", type text}, {"Giorno", Int64.Type}, {"GiornoSettimanaNumero", Int64.Type}, {"GiornoSettimana", type text}, {"FineSettimana", type logical}}, "it-IT"),
				    Display = Table.AddColumn(Typed, "Month", each Date.ToText([Data], "MMM yy", "en-US"), type text)
				in
				        Display

	column Month
		dataType: string
		lineageTag: 9755001d-ef0e-471d-91e6-b0987f44811c
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: AnnoMeseNumero
