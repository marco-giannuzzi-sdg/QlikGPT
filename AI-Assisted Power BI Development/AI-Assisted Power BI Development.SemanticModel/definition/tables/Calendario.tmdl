/// Calendario giornaliero continuo 2024-2026, marcato come tabella data.
table Calendario
	lineageTag: 73f8df9b-58db-4149-9976-f31d8f347ac8
	dataCategory: Time

	column Data
		dataType: dateTime
		isKey
		formatString: dd/MM/yyyy
		lineageTag: d6283a8c-77f0-4e5a-afcb-cdef44bcba7d
		summarizeBy: none
		sourceColumn: Data

		annotation UnderlyingDateTimeDataType = Date

	column Anno
