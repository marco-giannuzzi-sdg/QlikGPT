		summarizeBy: none
		sourceColumn: Giorno

	column GiornoSettimanaNumero
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 77dc8e08-1bde-405f-9d70-a744dbb02c2e
		summarizeBy: none
