/// Dati sintetici. Una riga per prodotto di un ordine. Importi in EUR, IVA esclusa. Vendite fino al 28/10/2026.
table Vendite
	lineageTag: 18f8aca2-9129-4b83-b9de-7877f98bbbb7

	/// Importi di riga al netto degli sconti; IVA esclusa.
	measure 'Fatturato Netto' = SUM(Vendite[ImportoNetto])
		formatString: € #,##0.00
		displayFolder: Indicatori
		lineageTag: 9691248d-4894-4feb-aca4-653c23115d2b

	/// Costo storico delle unita vendute.
	measure 'Costo Venduto' = SUM(Vendite[CostoTotale])
		formatString: € #,##0.00
		displayFolder: Indicatori
		lineageTag: ee0d7ab2-f924-463a-85c3-d8044c3927e1

	/// Fatturato netto meno costo del venduto.
	measure Margine = [Fatturato Netto] - [Costo Venduto]
		formatString: € #,##0.00
		displayFolder: Indicatori
		lineageTag: 27e0a033-63f4-4275-8d96-862f5cc8fbae

	/// Margine diviso fatturato netto.
	measure 'Margine %' = DIVIDE([Margine], [Fatturato Netto])
		formatString: 0.0%
		displayFolder: Indicatori
		lineageTag: 7d2b604c-1d26-415a-b2ee-be4eaddaf874

	/// Numero di unita vendute.
	measure 'Quantita Venduta' = SUM(Vendite[Quantita])
		formatString: #,##0
		displayFolder: Indicatori
		lineageTag: aae5ce96-07b9-477c-877c-cf475b9d779d

	/// Ordini distinti; un ordine puo avere piu righe.
	measure 'Numero Ordini' = DISTINCTCOUNT(Vendite[OrdineID])
		formatString: #,##0
		displayFolder: Indicatori
		lineageTag: 94687e49-facd-40b4-bdc6-1501909749f4

	/// Clienti con vendite nel contesto selezionato.
	measure 'Clienti Attivi' = DISTINCTCOUNT(Vendite[ClienteID])
		formatString: #,##0
		displayFolder: Indicatori
		lineageTag: fe53f43f-f939-4c4d-b962-6ab72214700d

	/// Fatturato netto diviso numero di ordini.
	measure 'Valore Medio Ordine' = DIVIDE([Fatturato Netto], [Numero Ordini])
		formatString: € #,##0.00
		displayFolder: Indicatori
		lineageTag: ad5855d8-6c13-4fd5-b1e2-4369c338b217

	column VenditaID
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: fd5200a7-32e0-4903-a2b0-2df1730d1a76
		summarizeBy: none
		sourceColumn: VenditaID

	column OrdineID
		dataType: string
		lineageTag: 582e9375-2802-4101-b22c-8a78dd54c371
		summarizeBy: none
		sourceColumn: OrdineID

	column DataVendita
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: e729c7f0-3041-404e-8c3e-69b4833c755b
		summarizeBy: none
		sourceColumn: DataVendita

		annotation UnderlyingDateTimeDataType = Date

	column ProdottoID
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 994a17a7-ae49-4455-8726-49873af9a2f4
		summarizeBy: none
		sourceColumn: ProdottoID

	column ClienteID
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d97328aa-3fdf-432a-a981-a64a437b362b
		summarizeBy: none
		sourceColumn: ClienteID

	column Quantita
		dataType: int64
		formatString: 0
		lineageTag: 99b1a4b2-80c6-4a9e-a74f-d63bb2d6c84f
		summarizeBy: none
		sourceColumn: Quantita

	column PrezzoUnitario
		dataType: decimal
		isHidden
		formatString: € #,##0.00
		lineageTag: 9f062e48-a38c-4aec-a33e-630abbdded36
		summarizeBy: none
		sourceColumn: PrezzoUnitario

	column ScontoPercentuale
		dataType: double
		isHidden
		formatString: 0.0%
		lineageTag: 68cc7e95-f3b1-470b-9623-b43d69ba2801
		summarizeBy: none
		sourceColumn: ScontoPercentuale

	column CostoUnitario
		dataType: decimal
		isHidden
		formatString: € #,##0.00
		lineageTag: 552b3ba1-e01f-4840-ad3d-eb82d382d413
		summarizeBy: none
		sourceColumn: CostoUnitario

	column ImportoNetto
		dataType: decimal
		isHidden
		formatString: € #,##0.00
		lineageTag: 2ad355dd-2687-4008-9bf6-06fc2204bdc1
		summarizeBy: none
		sourceColumn: ImportoNetto

	column CostoTotale
		dataType: decimal
		isHidden
		formatString: € #,##0.00
		lineageTag: 40ec18ed-2f93-4793-aab1-9fad5ab70d3e
		summarizeBy: none
		sourceColumn: CostoTotale

	column Canale
		dataType: string
		lineageTag: ebbf8c96-4441-443c-a397-fa78f18edd9c
		summarizeBy: none
		sourceColumn: Canale

	partition Vendite = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFolder & "Vendite.xlsx"), null, true),
				    Navigation = Source{[Item="Vendite", Kind="Table"]}[Data],
				    Typed = Table.TransformColumnTypes(Navigation, {{"VenditaID", Int64.Type}, {"OrdineID", type text}, {"DataVendita", type date}, {"ProdottoID", Int64.Type}, {"ClienteID", Int64.Type}, {"Quantita", Int64.Type}, {"PrezzoUnitario", Currency.Type}, {"ScontoPercentuale", type number}, {"CostoUnitario", Currency.Type}, {"ImportoNetto", Currency.Type}, {"CostoTotale", Currency.Type}, {"Canale", type text}}, "it-IT")
				in
				    Typed


	/// Fatturato sugli stessi giorni dell anno precedente.
	measure 'Fatturato Netto AP' = CALCULATE([Fatturato Netto], DATEADD(Calendario[Data], -1, YEAR))
		formatString: € #,##0.00
		displayFolder: Confronti
		lineageTag: d2efbbf1-e20b-4e11-8f06-eaa315e00045

	/// Ordini negli stessi giorni dell anno precedente.
	measure 'Numero Ordini AP' = CALCULATE([Numero Ordini], DATEADD(Calendario[Data], -1, YEAR))
		formatString: #,##0
		displayFolder: Confronti
		lineageTag: 6bafb158-c5e6-4c51-9ae9-a2d9fba74da4

	/// Unita vendute negli stessi giorni dell anno precedente.
	measure 'Quantita Venduta AP' = CALCULATE([Quantita Venduta], DATEADD(Calendario[Data], -1, YEAR))
		formatString: #,##0
		displayFolder: Confronti
		lineageTag: a722ee5a-d0dc-40c8-b66b-cddd4137c3f8

	/// Variazione rispetto allo stesso periodo dell anno precedente.
	measure 'Fatturato YoY %' = DIVIDE([Fatturato Netto] - [Fatturato Netto AP], [Fatturato Netto AP])
		formatString: 0.0%
		displayFolder: Confronti
		lineageTag: 4ba25072-bd58-4056-9d55-4975527c7b72

	/// Variazione degli ordini sul periodo equivalente.
	measure 'Ordini YoY %' = DIVIDE([Numero Ordini] - [Numero Ordini AP], [Numero Ordini AP])
		formatString: 0.0%
		displayFolder: Confronti
		lineageTag: 9ba2e177-68f2-48a5-9b45-c4bdb120cd0e

	/// Variazione delle unita vendute sul periodo equivalente.
	measure 'Quantita YoY %' = DIVIDE([Quantita Venduta] - [Quantita Venduta AP], [Quantita Venduta AP])
		formatString: 0.0%
		displayFolder: Confronti
		lineageTag: 2f06ff07-f690-4c65-a90d-ee64ef2d04f6

	/// Fatturato formattato per la card; nessun valore precalcolato.
	measure 'OV Revenue' = VAR v = [Fatturato Netto] RETURN IF(ISBLANK(v), "—", SWITCH(TRUE(), ABS(v) >= 1000000, FORMAT(v / 1000000, "€0.000", "en-US") & "M", ABS(v) >= 1000, FORMAT(v / 1000, "€0.0", "en-US") & "K", FORMAT(v, "€#,0", "en-US")))
		isHidden
		displayFolder: Overview
		lineageTag: 8369e71c-d5cd-42f3-9a30-c4dca07b3f23

	/// Margine percentuale nel contesto dei filtri.
	measure 'OV Margin' = IF(ISBLANK([Margine %]), "—", FORMAT([Margine %], "0.0%", "en-US"))
		isHidden
		displayFolder: Overview
		lineageTag: 86fa3fae-d3e5-4b8f-b88c-b170d4800344

	/// Ordini distinti nel contesto dei filtri.
	measure 'OV Orders' = IF(ISBLANK([Numero Ordini]), "—", FORMAT([Numero Ordini], "#,0", "en-US"))
		isHidden
		displayFolder: Overview
		lineageTag: 01e4be13-8bf6-4721-abc7-292918ad6f2c

	/// Quantita nel contesto dei filtri.
	measure 'OV Units' = IF(ISBLANK([Quantita Venduta]), "—", FORMAT([Quantita Venduta], "#,0", "en-US"))
		isHidden
		displayFolder: Overview
		lineageTag: f24e93c0-128c-473d-afb4-871ffef3eac2

	/// Etichetta dinamica della variazione fatturato.
	measure 'OV Revenue Change' = VAR v = [Fatturato YoY %] RETURN IF(ISBLANK(v), "No prior-year comparison", IF(v > 0, UNICHAR(9650) & " ", IF(v < 0, UNICHAR(9660) & " ", "")) & FORMAT(v, "+0.0%;-0.0%;0.0%", "en-US") & " vs prior year")
		isHidden
		displayFolder: Overview
		lineageTag: 8fb1e051-7c2a-4cd1-bfa8-0aedeb9c98d3

	/// Etichetta dinamica della variazione ordini.
	measure 'OV Orders Change' = VAR v = [Ordini YoY %] RETURN IF(ISBLANK(v), "No prior-year comparison", IF(v > 0, UNICHAR(9650) & " ", IF(v < 0, UNICHAR(9660) & " ", "")) & FORMAT(v, "+0.0%;-0.0%;0.0%", "en-US") & " vs prior year")
		isHidden
		displayFolder: Overview
		lineageTag: 708ad531-9f5d-423f-a899-f0e5bcddca3e

	/// Etichetta dinamica della variazione quantita.
	measure 'OV Units Change' = VAR v = [Quantita YoY %] RETURN IF(ISBLANK(v), "No prior-year comparison", IF(v > 0, UNICHAR(9650) & " ", IF(v < 0, UNICHAR(9660) & " ", "")) & FORMAT(v, "+0.0%;-0.0%;0.0%", "en-US") & " vs prior year")
		isHidden
		displayFolder: Overview
		lineageTag: 4eb8041a-6e16-4d23-8b1b-0ad81c953412

	/// Margine assoluto, non utile netto.
	measure 'OV Contribution' = VAR v = [Margine] RETURN IF(ISBLANK(v), "—", IF(ABS(v) >= 1000000, FORMAT(v / 1000000, "€0.000", "en-US") & "M", FORMAT(v / 1000, "€0.0", "en-US") & "K") & " contribution")
		isHidden
		displayFolder: Overview
		lineageTag: 223fef73-fea3-403d-89a6-3f1658aadd12

	/// Quota del segmento tra i segmenti selezionati, rispettando gli altri filtri.
	measure 'Quota Segmento %' = DIVIDE([Fatturato Netto], CALCULATE([Fatturato Netto], ALLSELECTED(Clienti[Segmento])))
		formatString: 0.0%
		displayFolder: Overview
		lineageTag: 7c32193e-670b-42fe-9c2e-41ab04637589

	/// Posizione della regione per fatturato nel contesto selezionato.
	measure 'OV Region Rank' = IF(NOT ISBLANK([Fatturato Netto]), RANKX(ALLSELECTED(Clienti[Regione]), [Fatturato Netto], , DESC, DENSE))
		formatString: 0
		isHidden
		displayFolder: Overview
		lineageTag: 9c88a374-717a-4761-a7ca-1ff9e7ad4d1b

	/// Intervallo confrontato nell anno precedente.
	measure 'OV Comparison Period' = VAR d = DATEADD(Calendario[Data], -1, YEAR) VAR dmin = MINX(d, Calendario[Data]) VAR dmax = MAXX(d, Calendario[Data]) RETURN IF(ISBLANK(dmin), "No comparable prior-year dates", "Compared with " & FORMAT(dmin, "dd MMM", "en-US") & " — " & FORMAT(dmax, "dd MMM yyyy", "en-US"))
		isHidden
		displayFolder: Overview
		lineageTag: 58e2c102-96e5-423c-92a2-5839676a6004

	/// Evidenzia il margine percentuale piu alto tra le categorie selezionate.
	measure 'OV Margin Highlight' = VAR v = [Margine %] VAR best = MAXX(ALLSELECTED(Prodotti[Categoria]), CALCULATE([Margine %])) RETURN IF(NOT ISBLANK(v) && v >= best, "#C7F464", "#FFFFFF")
		isHidden
		displayFolder: Overview
		lineageTag: 1e9405fe-1b8c-49fc-8fb4-72a29f222008

	/// Prodotti distinti con vendite nel periodo e nei filtri selezionati.
	measure 'Prodotti Venduti' = COALESCE(DISTINCTCOUNT(Vendite[ProdottoID]), 0)
		formatString: #,##0
		displayFolder: Products & Margin
		lineageTag: 5b71713c-b540-4a7d-a930-892ed88fc269

	/// Quota del fatturato dei primi cinque prodotti; ID crescente risolve eventuali pari merito.
	measure 'Quota Fatturato Top 5 Prodotti' = VAR p = ALLSELECTED(Prodotti) VAR t = TOPN(5, p, [Fatturato Netto], DESC, Prodotti[ProdottoID], ASC) RETURN DIVIDE(SUMX(t, [Fatturato Netto]), CALCULATE([Fatturato Netto], ALLSELECTED(Prodotti)))
		formatString: 0.0%
		displayFolder: Products & Margin
		lineageTag: da0e3761-1163-4997-b10f-2ef2bf89cb23

	/// Card dei prodotti attivi.
	measure 'PM Active Products' = FORMAT([Prodotti Venduti], "#,0", "en-US")
		isHidden
		displayFolder: Products & Margin
		lineageTag: 4989a07d-3b97-4b2a-be0a-81ff712cd419

	/// Margine assoluto formattato in EUR K o M.
	measure 'PM Gross Profit' = VAR v = [Margine] RETURN IF(ISBLANK(v), "—", SWITCH(TRUE(), ABS(v) >= 1000000, FORMAT(v / 1000000, "€0.000", "en-US") & "M", ABS(v) >= 1000, FORMAT(v / 1000, "€0.0", "en-US") & "K", FORMAT(v, "€#,0", "en-US")))
		isHidden
		displayFolder: Products & Margin
		lineageTag: c93314b2-950f-4e1a-a82d-87ab552269ed

	/// Card della concentrazione del fatturato.
	measure 'PM Top 5 Share' = IF(ISBLANK([Quota Fatturato Top 5 Prodotti]), "—", FORMAT([Quota Fatturato Top 5 Prodotti], "0.0%", "en-US"))
		isHidden
		displayFolder: Products & Margin
		lineageTag: 93f8b20d-86f6-4b05-89b3-34898bed7038

	/// Categoria del singolo prodotto per la matrice di dettaglio.
	measure 'PM Product Category' = SELECTEDVALUE(Prodotti[Categoria], "")
		isHidden
		displayFolder: Products & Margin
		lineageTag: db5f154a-918b-4ff2-97b1-ccf75d88e50b

	/// Posizione per margine assoluto tra i prodotti selezionati, con ID come spareggio.
	measure 'PM Profit Rank' = VAR v = [Margine] VAR k = SELECTEDVALUE(Prodotti[ProdottoID]) RETURN IF(NOT ISBLANK(v) && NOT ISBLANK(k), COUNTROWS(FILTER(ALLSELECTED(Prodotti), VAR a = CALCULATE([Margine]) RETURN NOT ISBLANK(a) && (a > v || (a = v && Prodotti[ProdottoID] <= k)))))
		formatString: 0
		isHidden
		displayFolder: Products & Margin
		lineageTag: 6736f888-ab16-4de1-97de-706d2da65067

	/// Posizione per fatturato tra i prodotti selezionati, con ID come spareggio.
	measure 'PM Revenue Rank' = VAR v = [Fatturato Netto] VAR k = SELECTEDVALUE(Prodotti[ProdottoID]) RETURN IF(NOT ISBLANK(v) && NOT ISBLANK(k), COUNTROWS(FILTER(ALLSELECTED(Prodotti), VAR a = CALCULATE([Fatturato Netto]) RETURN NOT ISBLANK(a) && (a > v || (a = v && Prodotti[ProdottoID] <= k)))))
		formatString: 0
		isHidden
		displayFolder: Products & Margin
		lineageTag: b4438314-80a6-4424-bb51-1f0519c951cf

	/// Fatturato del portafoglio selezionato senza il filtro della singola bolla.
	measure 'PM Portfolio Revenue' = CALCULATE([Fatturato Netto], ALLSELECTED(Prodotti))
		formatString: € #,##0.00
		isHidden
		displayFolder: Products & Margin
		lineageTag: 95c97b5a-e215-4aff-ba5f-6c3a8953316a

	/// Margine ponderato del portafoglio selezionato: rapporto tra somme.
	measure 'PM Portfolio Margin' = CALCULATE([Margine %], ALLSELECTED(Prodotti))
		formatString: 0.0%
		isHidden
		displayFolder: Products & Margin
		lineageTag: d4c8e49a-48b6-46e1-bb5c-403341907426

	/// Fatturato medio per prodotto con vendite, nei filtri selezionati.
	measure 'PM Average Product Revenue' = DIVIDE([PM Portfolio Revenue], CALCULATE([Prodotti Venduti], ALLSELECTED(Prodotti)))
		formatString: € #,##0.00
		isHidden
		displayFolder: Products & Margin
		lineageTag: 1df6303b-6da3-4858-9b91-dad651782c7e

	/// Limite dinamico dell asse fatturato con margine per le bolle.
	measure 'PM Scatter Revenue Limit' = VAR v = MAXX(ALLSELECTED(Prodotti), [Fatturato Netto]) RETURN IF(ISBLANK(v), 10000, CEILING(v * 1.08, 10000))
		formatString: 0
		isHidden
		displayFolder: Products & Margin
		lineageTag: 7cc43434-ea71-498d-b0aa-fcf26c402882

	/// Seconda riga delle etichette dei prodotti per margine assoluto.
	measure 'PM Margin Label' = IF(ISBLANK([Margine %]), "", FORMAT([Margine %], "0.0%", "en-US") & " margin")
		isHidden
		displayFolder: Products & Margin
		lineageTag: e187e9e3-3568-4ca6-bcf5-5807108e6d87

	/// Valori delle due linee di riferimento nel grafico a bolle.
	measure 'PM Reference Caption' = VAR r = [PM Average Product Revenue] VAR m = [PM Portfolio Margin] RETURN IF(ISBLANK(r), "No sales in the selected period", "Portfolio averages: revenue / product " & FORMAT(r / 1000, "€0.0", "en-US") & "K · gross margin " & FORMAT(m, "0.0%", "en-US"))
		isHidden
		displayFolder: Products & Margin
		lineageTag: 3debbf73-4230-479a-9a83-9384cbd2f79d

	/// Colore della prima posizione nella classifica per margine, dinamico con i filtri.
	measure 'PM Profit Driver Color' = IF([PM Profit Rank] = 1, "#081C30", "#187F82")
		isHidden
		displayFolder: Products & Margin
		lineageTag: abf01418-fc37-4cab-ba07-993a79a391c1
