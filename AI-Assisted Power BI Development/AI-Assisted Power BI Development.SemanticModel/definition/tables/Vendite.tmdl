	partition Vendite = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFolder & "Vendite.xlsx"), null, true),
				    Navigation = Source{[Item="Vendite", Kind="Table"]}[Data],
				    Typed = Table.TransformColumnTypes(Navigation, {{"VenditaID", Int64.Type}, {"OrdineID", type text}, {"DataVendita", type date}, {"ProdottoID", Int64.Type}, {"ClienteID", Int64.Type}, {"Quantita", Int64.Type}, {"PrezzoUnitario", Currency.Type}, {"ScontoPercentuale", type number}, {"CostoUnitario", Currency.Type}, {"ImportoNetto", Currency.Type}, {"CostoTotale", Currency.Type}, {"Canale", type text}}, "it-IT")
				in
