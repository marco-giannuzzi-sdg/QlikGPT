model Model
	culture: it-IT
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: it-IT
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Prodotti","Clienti","Calendario","Vendite","DataFolder"]

ref table Prodotti
ref table Clienti
ref table Calendario
ref table Vendite

ref cultureInfo it-IT

